{
  "name": "kyro-snes-port-desktop",
  "productName": "Kyro SNES",
  "version": "1.1.0",
  "private": true,
  "description": "Kyro SNES Port — player desktop com núcleo snes9x em WebAssembly",
  "main": "main.js",
  "author": "Kyro",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win portable",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "tools.kyro.snes",
    "productName": "Kyro SNES",
    "copyright": "Kyro SNES Port",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "static-server.js",
      "app/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Kyro-SNES-Port-${version}.exe"
    }
  }
}
